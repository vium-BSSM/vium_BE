# Copy to .env.prod on the deployment host. Never commit real secrets.
DB_URL=jdbc:postgresql://replace-with-rds-endpoint:5432/vium?sslmode=verify-full&sslrootcert=/app/certs/global-bundle.pem
DB_USERNAME=replace_with_db_username
DB_PASSWORD='replace_with_db_password'
# Generate on the deployment host: openssl rand -base64 32
JWT_SECRET=replace_with_base64_encoded_random_key
JWT_ISSUER=vium
JWT_ACCESS_TOKEN_SECONDS=3600
JWT_REFRESH_TOKEN_SECONDS=1209600
JWT_CLOCK_SKEW_SECONDS=60
# Recipe recommendation and image lookup. Keep real keys on the deployment host.
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
UNSPLASH_ACCESS_KEY=replace_with_unsplash_access_key
# Exact frontend origins, comma-separated, no trailing slash. Empty blocks cross-origin access.
CORS_ALLOWED_ORIGINS=

# Enable after configuring IAM DeleteObject and Nginx upload limit.
IMAGE_STORAGE_ENABLED=false
AWS_REGION=ap-northeast-2
S3_PRIVATE_BUCKET=vium-prod-private-243919538384
S3_PUBLIC_BUCKET=vium-prod-public-assets-243919538384
IMAGE_PUBLIC_BASE_URL=https://d3eyp8dyewtbe4.cloudfront.net

# Grafana Cloud metrics (OTLP push). Token needs only the metrics:write scope.
OTLP_METRICS_ENABLED=false
# Replace with your stack's OTLP endpoint plus /v1/metrics.
OTLP_METRICS_URL=https://otlp-gateway-prod-ap-northeast-0.grafana.net/otlp/v1/metrics
# 'Basic ' + base64("<instance id>:<access policy token>")
OTLP_METRICS_AUTHORIZATION='Basic replace_with_base64_credentials'
