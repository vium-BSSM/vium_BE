// PickDo(비움) DB 스키마 — Flyway V1~V11 적용 결과 + 거래 기능 설계안
Project PickDo {
  database_type: "PostgreSQL"
  Note: '''
  post·trade·credit·chat·safety·ai_report 그룹과 credit_base_values·user_push_tokens는 추가 기능(#143) 설계안이며 아직 마이그레이션이 없다.
  위치 컬럼은 PostGIS geography(Point, 4326)를 쓴다.
  '''
}

Table users {
  id bigint [pk, increment]
  email varchar(255) [unique, not null]
  display_name varchar(80) [not null]
  password_hash varchar(255) [note: '소셜 전용 계정이면 NULL 허용']
  expiry_alert_days smallint [not null, default: `2`, note: 'D-N 임박 알림 기준']
  auto_dispose_enabled boolean [not null, default: `true`]
  shopping_reminder_enabled boolean [not null, default: `false`]
  push_enabled boolean [not null, default: `true`]
  profile_image_id bigint [note: 'V11. purpose=PROFILE 이미지']
  created_at timestamp [not null]
  updated_at timestamp [not null]
  deleted_at timestamp

  Note: '''
  (email = lower(btrim(email)))
  '''
}

Table auth_providers {
  id smallint [pk, increment]
  code varchar(30) [unique, not null]
  name varchar(50) [not null]
}

Table user_auth_accounts {
  id bigint [pk, increment]
  user_id bigint [not null]
  auth_provider_id smallint [not null]
  provider_user_key varchar(255) [not null]
  created_at timestamp [not null]

  indexes {
    (auth_provider_id, provider_user_key) [unique]
    user_id
  }
}

Table user_sessions {
  id bigint [pk, increment]
  user_id bigint [not null]
  refresh_token_hash varchar(255) [unique, not null]
  issued_at timestamp [not null]
  expires_at timestamp [not null]
  revoked_at timestamp

  indexes {
    user_id
  }
}

Table units {
  id smallint [pk, increment]
  code varchar(20) [unique, not null]
  name varchar(40) [not null]
}

Table storage_methods {
  id smallint [pk, increment]
  code varchar(30) [unique, not null]
  name varchar(50) [not null]
}

Table purchase_sources {
  id smallint [pk, increment]
  code varchar(30) [unique, not null]
  name varchar(50) [not null]
}

Table item_statuses {
  id smallint [pk, increment]
  code varchar(20) [unique, not null]
  name varchar(40) [not null]

  Note: '''
  active / consumed / disposed
  거래 기능: shared(나눔·판매로 넘김) 추가 예정
  '''
}

Table event_sources {
  id smallint [pk, increment]
  code varchar(20) [unique, not null]
  name varchar(40) [not null]
}

Table ingredient_categories {
  id smallint [pk, increment]
  name varchar(60) [unique, not null]
  parent_id smallint

  indexes {
    parent_id
  }
}

Table credit_base_values {
  category_id smallint [not null]
  unit_id smallint [not null]
  base_value numeric(8,3) [not null, note: '기준 단위 1당 기준 크레딧']

  indexes {
    (category_id, unit_id) [pk]
  }

  Note: '''
  거래 기능: 추천 크레딧 = round(base_value × 기준 단위 수량 × 신선도 계수)
  unit_id는 기준 단위만 쓴다: kg, L, 그리고 환산할 수 없는 개·팩·봉·병·캔·통. g·ml 행은 두지 않는다
  g은 kg(÷1000), ml은 L(÷1000)로 환산한 뒤 계산하므로 1kg과 1000g은 같은 추천가가 나온다
  행이 없거나 계산된 추천가가 0이면 판매 불가, 나눔(SHARE)만 허용한다
  '''
}

Table ingredient_catalog {
  id bigint [pk, increment]
  category_id smallint
  default_unit_id smallint [not null]
  name varchar(120) [unique, not null]
  post_allowed boolean [not null, default: `true`, note: '거래 기능: 게시 허용 여부. 품목 단위로 판단']
  created_at timestamp [not null]

  indexes {
    category_id
  }

  Note: '''
  거래 기능: post_allowed는 육류·수산물 카테고리 품목과, 다른 카테고리에 있는 날고기·수산물 품목(냉동새우·냉동오징어·냉동연어·냉동대구 등)을 false로 시드한다
  카탈로그를 고르지 않은 재고(ingredient_catalog_id IS NULL)는 품목을 판별할 수 없어 게시할 수 없다
  '''
}

Table expiry_estimation_rules {
  id bigint [pk, increment]
  ingredient_catalog_id bigint [not null]
  storage_method_id smallint [not null]
  shelf_life_days integer [not null]
  source varchar(80)
  effective_from date [not null]
  effective_to date

  indexes {
    (ingredient_catalog_id, storage_method_id, effective_from) [unique]
  }
}

Table purchases {
  id bigint [pk, increment]
  user_id bigint [not null]
  purchase_source_id smallint
  total_amount numeric(12,2)
  purchased_at timestamp [not null]
  created_at timestamp [not null]
  type varchar(20) [not null]
  status varchar(20) [not null]
  image_id bigint
  confirmed_at timestamp

  indexes {
    (user_id, purchased_at) [note: 'purchased_at DESC']
    user_id
  }

  Note: '''
  status IN ('DRAFT', 'CONFIRMED')
  type IN ('RECEIPT', 'ONLINE_ORDER')
  '''
}

Table purchase_items {
  id bigint [pk, increment]
  purchase_id bigint [not null]
  ingredient_catalog_id bigint
  raw_name varchar(200) [note: '영수증 원문 품목명(미매칭 대비)']
  quantity numeric(12,3) [not null]
  unit_id smallint [not null]
  unit_price numeric(12,2)
  amount numeric(12,2)
  storage_method_id smallint
  expires_on date

  indexes {
    ingredient_catalog_id
    purchase_id
  }
}

Table inventory_items {
  id bigint [pk, increment]
  user_id bigint [not null]
  ingredient_catalog_id bigint
  purchase_item_id bigint
  custom_name varchar(120) [note: '카탈로그에 없는 재료 직접 입력용']
  status_id smallint [not null]
  storage_method_id smallint
  unit_id smallint [not null]
  initial_quantity numeric(12,3) [not null]
  remaining_quantity numeric(12,3) [not null]
  amount numeric(12,2) [note: '낭비 금액 집계용 취득가']
  purchased_on date
  expires_on date [note: '자동 추정값, 사용자가 수정 가능']
  created_at timestamp [not null]
  updated_at timestamp [not null]

  indexes {
    ingredient_catalog_id
    (user_id, expires_on)
    user_id
    (user_id, status_id)
  }

  Note: '''
  (ingredient_catalog_id IS NOT NULL) OR (custom_name IS NOT NULL)
  삭제(DELETE /api/me/ingredients/{id})는 하드 삭제다. consumption_events·posts·trades에 연결된 재고는 삭제할 수 없고, 이 재고를 가리키는 notifications는 함께 지운다
  '''
}

Table consumption_events {
  id bigint [pk, increment]
  inventory_item_id bigint [not null]
  user_id bigint [not null]
  event_type varchar(20) [not null, note: 'consumed / disposed (거래 기능: shared 추가 예정)']
  event_source_id smallint [not null, note: 'manual / auto_estimated']
  quantity numeric(12,3) [not null, note: '게이지로 조절한 처리량']
  amount numeric(12,2) [note: '해당 처리량의 금액(낭비 집계용)']
  occurred_at timestamp [not null]
  created_at timestamp [not null]

  indexes {
    inventory_item_id
    (user_id, event_type, occurred_at)
  }
}

Table shopping_list_items {
  id bigint [pk, increment]
  user_id bigint [not null]
  ingredient_catalog_id bigint
  custom_name varchar(120)
  suggested_quantity numeric(12,3) [note: '낭비 이력 기반 제안량']
  unit_id smallint
  reason varchar(200) [note: '예: \'지난달 절반을 버림 → 절반만\'']
  is_checked boolean [not null, default: `false`]
  created_at timestamp [not null]

  indexes {
    ingredient_catalog_id
    user_id
  }
}

Table user_push_tokens {
  id bigint [pk, increment]
  user_id bigint [not null]
  token varchar(512) [unique, not null, note: 'FCM 등록 토큰. 다른 사용자가 같은 토큰을 등록하면 소유자를 옮긴다']
  platform varchar(10) [not null, note: 'ANDROID / IOS']
  created_at timestamptz [not null]
  updated_at timestamptz [not null, note: '마지막 등록 시각']

  indexes {
    user_id
  }

  Note: '''
  푸시 발송 대상 기기. 로그아웃 시 해제 API로, 회원 탈퇴 시 전부, FCM 무효 토큰 응답 시 서버가 삭제한다
  설계안이며 아직 마이그레이션이 없다
  '''
}

Table notifications {
  id bigint [pk, increment]
  user_id bigint [not null]
  type varchar(30) [not null, note: 'expiry / consume_check / shopping_reminder (API 예시는 expiry_popup이라 값 통일 필요)']
  inventory_item_id bigint
  title varchar(120) [not null]
  body varchar(500)
  scheduled_at timestamp [not null]
  sent_at timestamp
  read_at timestamp
  created_at timestamp [not null]

  indexes {
    inventory_item_id
    (user_id, scheduled_at)
  }
}

Table recipes {
  id bigint [pk, increment]
  title varchar(200) [not null]
  description varchar(1000)
  source varchar(120)
  created_at timestamp [not null]
  category varchar(20) [not null]
  cook_time integer [not null]
  image_url varchar(1000)
  image_author_name varchar(255)
  image_author_url varchar(500)
  detail_status varchar(20) [not null, default: 'BASIC']
  detail_generation_started_at timestamptz

  indexes {
    (source, category, created_at) [note: 'created_at DESC']
  }

  Note: '''
  (cook_time >= 1) AND (cook_time <= 180)
  category IN ('KOREAN', 'CHINESE', 'WESTERN', 'JAPANESE', 'DESSERT')
  detail_status IN ('BASIC', 'GENERATING', 'DETAILED')
  '''
}

Table recipe_ingredients {
  id bigint [pk, increment]
  recipe_id bigint [not null]
  ingredient_catalog_id bigint [not null]
  amount varchar(50) [note: '상세 생성 후 채워지는 분량']

  indexes {
    (recipe_id, ingredient_catalog_id) [unique]
  }
}

Table recipe_seasonings {
  id bigint [pk, increment]
  recipe_id bigint [not null]
  name varchar(30) [not null]
  amount varchar(50) [not null]
  sort_order integer [not null]

  indexes {
    (recipe_id, sort_order) [unique]
  }

  Note: '''
  기본 양념(소금·설탕·간장 등). ingredient_catalog 재료가 아니라 별도 테이블
  (sort_order >= 1)
  '''
}

Table recipe_steps {
  id bigint [pk, increment]
  recipe_id bigint [not null]
  step_order integer [not null]
  description varchar(500) [not null]

  indexes {
    (recipe_id, step_order) [unique]
  }

  Note: '''
  (step_order >= 1)
  '''
}

Table recipe_suggestions {
  id bigint [pk, increment]
  user_id bigint [not null]
  recipe_id bigint [not null]
  suggested_at timestamp [not null]
  reason varchar(200) [note: '임박 재료 조합 근거']
  batch_id uuid [not null]
  inventory_hash varchar(64) [not null]

  indexes {
    batch_id
    (user_id, recipe_id)
    recipe_id
    (user_id, suggested_at)
  }
}

Table uploaded_images {
  id bigint [pk, increment]
  user_id bigint [not null]
  purpose varchar(20) [not null]
  bucket varchar(63) [not null]
  object_key varchar(200) [unique, not null]
  content_type varchar(30) [not null]
  size_bytes bigint [not null]
  created_at timestamptz [not null]
  ready boolean [not null, default: `false`]

  indexes {
    (ready, created_at)
    user_id
  }

  Note: '''
  S3 이미지 메타데이터. ready=false는 업로드 중 또는 정리 재시도 대상
  content_type IN ('image/jpeg', 'image/png')
  purpose IN ('RECEIPT', 'PROFILE', 'RECIPE') (거래 기능: 'POST', 'CHAT' 추가 예정)
  (size_bytes >= 1) AND (size_bytes <= 5242880)
  '''
}

// ---------------------------------------------------------------- 거래 기능 설계안 (#143, 마이그레이션 미적용)

Table posts {
  id bigint [pk, increment]
  author_id bigint [not null]
  inventory_item_id bigint [not null, note: '재고 1건을 통째로 게시']
  type varchar(10) [not null, note: 'SHARE / SALE']
  status varchar(20) [not null, note: 'OPEN / RESERVED / COMPLETED / EXPIRED']
  title varchar(50) [not null]
  description varchar(1000) [not null, default: '', note: '생략하면 빈 문자열로 저장']
  price integer [not null, default: 0, note: '크레딧. SHARE면 0']
  recommended_price integer [note: '게시 시점 추천가. 판매가는 max(1, ceil(추천가×0.8)) ~ floor(추천가×1.2)']
  is_opened boolean [not null]
  location geography [not null, note: 'geography(Point, 4326). 게시 위치']
  like_count integer [not null, default: 0]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz [note: '삭제 시 재고 잠금 해제']

  indexes {
    (status, created_at)
    author_id
    inventory_item_id [note: 'deleted_at IS NULL 부분 유니크']
  }

  Note: '''
  location은 GiST 인덱스가 필요하다. DBML은 btree·hash만 지원하므로 마이그레이션에서 USING GIST로 선언한다
  게시 잠금: deleted_at IS NULL AND status IN ('OPEN', 'RESERVED')인 게시물의 재고는 소진/폐기·수정·요리 완료 차감이 잠긴다 (공통 재고 변경 경로에서 검사)
  거래가 완료되면 판매자 재고는 shared 상태로 종료되며, 이후 변경 제한은 재고 상태 규칙으로 처리한다
  type IN ('SHARE', 'SALE')
  status IN ('OPEN', 'RESERVED', 'COMPLETED', 'EXPIRED')
  (type = 'SALE' AND price >= 1) OR (type = 'SHARE' AND price = 0)
  '''
}

Table post_images {
  id bigint [pk, increment]
  post_id bigint [not null]
  image_id bigint [unique, not null]
  sort_order smallint [not null, note: '1이 썸네일, 최대 5']

  indexes {
    (post_id, sort_order) [unique]
  }
}

Table post_likes {
  user_id bigint [not null]
  post_id bigint [not null]
  created_at timestamptz [not null]

  indexes {
    (user_id, post_id) [pk]
    post_id
  }
}

Table trades {
  id bigint [pk, increment]
  post_id bigint [not null]
  buyer_id bigint [not null]
  seller_id bigint [not null]
  status varchar(20) [not null, note: 'REQUESTED / ACCEPTED / COMPLETED / REJECTED / CANCELED']
  price integer [not null, note: '요청 시점 게시물 가격. 이 금액을 보류']
  buyer_inventory_item_id bigint [unique, note: '완료 시 구매자에게 생긴 재고. 거래 하나에 재고 하나']
  canceled_by_id bigint
  cancel_reason varchar(200)
  requested_at timestamptz [not null]
  accepted_at timestamptz
  auto_resolve_at timestamptz [note: '자동 완료 시각 = accepted_at + 72시간. 24시간 전 SYSTEM 메시지로 안내']
  completed_at timestamptz
  closed_at timestamptz [note: '거절·취소 시각']

  indexes {
    post_id [note: 'status IN (REQUESTED, ACCEPTED) 부분 유니크: 게시물당 진행 중 거래 1건']
    (buyer_id, requested_at)
    (seller_id, requested_at)
    (status, auto_resolve_at)
  }

  Note: '''
  상태 변경은 posts·trades 행을 SELECT ... FOR UPDATE로 잠근 뒤 상태를 다시 확인하고, 재고·크레딧 변경까지 한 트랜잭션에서 처리한다
  잠금 순서는 모든 경로에서 posts → trades → inventory_items → users, 같은 종류의 여러 행은 ID 오름차순
  COMPLETED·REJECTED·CANCELED 거래는 만료 검사 없이 거절한다. 진행 중 거래의 만료 처리(취소·환불)는 409를 돌려줘도 커밋한다
  '''
}

Table trade_reviews {
  id bigint [pk, increment]
  trade_id bigint [not null]
  writer_id bigint [not null]
  target_user_id bigint [not null]
  manner_score smallint [not null, note: '1~5']
  content varchar(500)
  created_at timestamptz [not null]

  indexes {
    (trade_id, writer_id) [unique]
    (target_user_id, created_at)
  }
}

Table credit_transactions {
  id bigint [pk, increment]
  user_id bigint [not null]
  type varchar(30) [not null]
  amount integer [not null, note: '부호 있는 변동량. 적립·환불 +, 보류·사용 -']
  trade_id bigint
  ai_waste_report_id bigint
  reward_date date [note: 'DAILY_REWARD(하루 1회)·SAVING_BONUS(판매자당 하루 3회) 상한 판단용 (Asia/Seoul)']
  provider_transaction_id varchar(100) [unique, note: '오퍼월 중복 지급 방지']
  created_at timestamptz [not null]

  indexes {
    (user_id, created_at)
    (user_id, reward_date) [note: 'type = DAILY_REWARD 부분 유니크']
    trade_id
  }

  Note: '''
  사용 가능 잔액 = SUM(amount). 보류 잔액 = 내가 구매자인 REQUESTED·ACCEPTED 거래의 price 합
  차감(TRADE_HOLD·AI_REPORT) 전에는 users 행을 SELECT ... FOR UPDATE로 잠근 뒤 잔액을 확인하고 내역을 넣는다. 같은 사용자의 동시 차감을 직렬화하기 위함
  type IN ('SIGNUP_REWARD', 'AD_REWARD', 'DAILY_REWARD', 'SAVING_BONUS', 'TRADE_HOLD', 'TRADE_REFUND', 'TRADE_INCOME', 'AI_REPORT')
  SAVING_BONUS는 최근 7일 안에 같은 상대와 완료한 거래가 이미 있으면 지급하지 않는다
  '''
}

Table chat_rooms {
  id bigint [pk, increment]
  post_id bigint [not null]
  buyer_id bigint [not null]
  seller_id bigint [not null]
  last_message_at timestamptz
  created_at timestamptz [not null]

  indexes {
    (post_id, buyer_id) [unique]
  }
}

Table chat_participants {
  chat_room_id bigint [not null]
  user_id bigint [not null]
  last_read_message_id bigint
  left_at timestamptz [note: '나가기. 상대가 새 메시지를 보내거나 구매자가 채팅방 생성을 다시 호출하면 null로 복귀']

  indexes {
    (chat_room_id, user_id) [pk]
    (user_id, left_at)
  }
}

Table chat_messages {
  id bigint [pk, increment]
  chat_room_id bigint [not null]
  sender_id bigint [note: 'SYSTEM이면 NULL']
  type varchar(10) [not null, note: 'TEXT / IMAGE / SYSTEM']
  content varchar(1000)
  image_id bigint
  system_event varchar(30) [note: 'TRADE_REQUESTED / ACCEPTED / REJECTED / CANCELED / COMPLETED / AUTO_COMPLETE_SOON']
  created_at timestamptz [not null]

  indexes {
    (chat_room_id, id) [note: 'id DESC, 커서 페이지네이션']
  }
}

Table user_blocks {
  blocker_id bigint [not null]
  blocked_id bigint [not null]
  created_at timestamptz [not null]

  indexes {
    (blocker_id, blocked_id) [pk]
    blocked_id
  }

  Note: '(blocker_id <> blocked_id)'
}

Table user_reports {
  id bigint [pk, increment]
  reporter_id bigint [not null]
  target_type varchar(10) [not null, note: 'USER / POST']
  target_user_id bigint
  target_post_id bigint
  reason varchar(20) [not null, note: 'SPAM / FRAUD / PROHIBITED_ITEM / ABUSIVE / ETC']
  detail varchar(500)
  status varchar(20) [not null, default: 'RECEIVED', note: 'RECEIVED / REVIEWED']
  created_at timestamptz [not null]

  indexes {
    (reporter_id, target_user_id) [note: 'target_type = USER 부분 유니크']
    (reporter_id, target_post_id) [note: 'target_type = POST 부분 유니크']
  }

  Note: '''
  target_type = USER면 target_user_id, POST면 target_post_id만 채운다
  (target_type = 'USER' AND target_user_id IS NOT NULL AND target_post_id IS NULL) OR (target_type = 'POST' AND target_post_id IS NOT NULL AND target_user_id IS NULL)
  중복 신고 방지는 일반 UNIQUE로는 NULL 때문에 동작하지 않으므로 마이그레이션에서 부분 유니크 인덱스 2개로 만든다
  '''
}

Table ai_waste_reports {
  id bigint [pk, increment]
  user_id bigint [not null]
  year_month char(7) [not null, note: 'YYYY-MM']
  cost integer [not null]
  summary text [not null]
  insights jsonb [not null, note: '[{title, body}]']
  suggestions jsonb [not null, note: '[string]']
  created_at timestamptz [not null]

  indexes {
    (user_id, year_month) [unique]
  }
}

