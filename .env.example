POSTGRES_DB=your_postgres_database
POSTGRES_USER=your_postgres_username
POSTGRES_PASSWORD=your_postgres_password

DB_URL=jdbc:postgresql://localhost:5432/your_postgres_database
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
SERVER_PORT=8080

# Generate a random signing key: openssl rand -base64 32
JWT_SECRET=replace_with_base64_encoded_random_key
JWT_ISSUER=vium
JWT_ACCESS_TOKEN_SECONDS=3600
JWT_REFRESH_TOKEN_SECONDS=1209600
JWT_CLOCK_SKEW_SECONDS=60

# Set the exact local frontend origin when needed, e.g. http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Recipe recommendation and image lookup (required at startup).
GEMINI_API_KEY=replace_with_gemini_api_key
UNSPLASH_ACCESS_KEY=replace_with_unsplash_access_key

# Food safety open API key, used only by scripts/catalog/fetch_i1250.py.
FOODSAFETY_API_KEY=

# Optional Grafana Cloud metrics (OTLP push). See docs/monitoring.md.
OTLP_METRICS_ENABLED=false
OTLP_METRICS_URL=https://otlp-gateway-prod-ap-northeast-0.grafana.net/otlp/v1/metrics
# 'Basic ' + base64("<instance id>:<access policy token>")
OTLP_METRICS_AUTHORIZATION='Basic replace_with_base64_credentials'
